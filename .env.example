# ============================================================
#  COPY file ini menjadi .env.local dan isi nilai sebenarnya
#  Jangan pernah commit .env.local ke repository publik
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Untuk route handler server (telegram notif) - gunakan service role
# Hanya dipakai di server, tidak akan terekspos ke browser
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- Telegram Bot (notifikasi admin) ---
TELEGRAM_BOT_TOKEN=YOUR-TELEGRAM-BOT-TOKEN
TELEGRAM_CHAT_ID=YOUR-TELEGRAM-CHAT-ID

# --- Admin seeding (jalankan sekali via /admin/seed) ---
ADMIN_SEED_EMAIL=admin@rekber.test
ADMIN_SEED_PASSWORD=ChangeMe123!
